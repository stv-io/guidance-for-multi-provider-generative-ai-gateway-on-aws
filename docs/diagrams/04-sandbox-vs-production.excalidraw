      "type": "text",
      "x": 1222,
      "y": 318,
      "strokeColor": "#495057",
      "roughness": 0,
      "text": "same path, in the production account's hosted zone\ncertificates requested by the stack, or bring your own:\nACM in us-east-1 (CloudFront) + eu-west-1 (ALB :443)",
      "fontSize": 11,
      "fontFamily": 2,
      "textAlign": "left",
      "createdAt": "2026-10-22T07:41:46.982Z",
