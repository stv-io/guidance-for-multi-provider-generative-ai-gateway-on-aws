   "text": "only when DISABLE_OUTBOUND_NETWORK_ACCESS=true\n(or CREATE_VPC_ENDPOINTS_IN_EXISTING_VPC=true):\nbedrock, bedrock-runtime, bedrock-agent, sagemaker.runtime,\nsecretsmanager, ecr.api, ecr.dkr, logs, sts, ssm, \u2026",
