  },
  {
   "id": "net-t-2",
   "type": "text",
   "x": 60,
   "y": 76,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "New VPC created by modules/base \u00b7 2 AZs \u00b7 internal ALB behind a CloudFront VPC origin \u00b7 blue = public subnet \u00b7 green = private subnet \u00b7 dashed = conditional or scale-out only \u00b7 red = request path \u00b7 grey = egress / data",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:39:09.140Z",
