   "version": 1
  },
  {
   "id": "rt-t-44",
   "type": "text",
   "x": 1250,
   "y": 188.25,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "health check: /health/liveliness\nOpenAI-compatible API \u00b7 Admin UI (/ui)\nvirtual keys, budgets, rate limits\n\u2192 Bedrock / external providers",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
   "updatedAt": "2026-10-22T07:40:15.183Z",
   "version": 1
  },
  {
   "id": "rt-r-45",
