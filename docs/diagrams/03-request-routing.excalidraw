   "version": 1
  },
  {
   "id": "rt-t-46",
   "type": "text",
   "x": 1250,
   "y": 308,
   "strokeColor": "#1971c2",
   "roughness": 0,
   "text": "Target group :3000 \u00b7 middleware (Python 3.14)",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
   "updatedAt": "2026-10-22T07:40:15.183Z",
   "version": 1
  },
  {
   "id": "rt-t-47",
   "type": "text",
   "x": 1250,
   "y": 328.25,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "health check: /bedrock/health/liveliness\nBedrock Converse API \u2192 OpenAI format\nchat history in RDS (middleware DB)\n/key/generate: admin check, else 403\nOkta JWT \u2192 LiteLLM user (optional)",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
   "updatedAt": "2026-10-22T07:40:15.183Z",
