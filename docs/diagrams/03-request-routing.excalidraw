  {
   "id": "rt-t-52",
   "type": "text",
   "x": 1420,
   "y": 276,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "localhost:4000 \u00b7 same Bearer key",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
