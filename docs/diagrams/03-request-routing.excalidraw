  {
   "id": "rt-t-60",
   "type": "text",
   "x": 142,
   "y": 672,
   "strokeColor": "#1e1e1e",
   "roughness": 0,
   "text": "Master + salt key",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
   "updatedAt": "2026-10-22T07:40:15.183Z",
   "version": 1
  },
  {
   "id": "rt-t-61",
   "type": "text",
   "x": 142,
   "y": 692,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "random, stored in Secrets Manager (LiteLLMMasterSalt-*)\ninjected into both containers at task start\nadmin calls: /key/generate, /user/new, /key/delete\nAdmin UI login: admin / master key",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.183Z",
   "updatedAt": "2026-10-22T07:40:15.183Z",
   "version": 1
  },
  {
   "id": "rt-r-62",
