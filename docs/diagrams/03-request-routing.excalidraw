   "strokeColor": "#1e1e1e",
   "roughness": 0,
   "text": "Request routing \u2014 CloudFront, ALB listener rules and auth",
   "fontSize": 28,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.181Z",
   "updatedAt": "2026-10-22T07:40:15.181Z",
   "version": 1
  },
  {
   "id": "rt-t-2",
   "type": "text",
   "x": 60,
   "y": 76,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "Rules in priority order, from modules/ecs/alb.tf   \u00b7   blue = middleware target :3000   \u00b7   green = LiteLLM target :4000   \u00b7   pink = rejected",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.181Z",
   "updatedAt": "2026-10-22T07:40:15.181Z",
   "version": 1
  },
