  {
   "id": "rt-t-28",
   "type": "text",
   "x": 476,
   "y": 285,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "P8  /chat-history\nP10 /bedrock/health/liveliness\nP12 /key/generate  (admin only)\nP14 /chat/completions\nP16 /bedrock/model/*",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.182Z",
   "updatedAt": "2026-10-22T07:40:15.182Z",
   "version": 1
  },
  {
   "id": "rt-t-29",
   "type": "text",
   "x": 800,
   "y": 285,
   "strokeColor": "#495057",
   "roughness": 0,
   "text": "P9  /bedrock/chat-history\nP11 /session-ids\nP13 /user/new\nP15 /v1/chat/completions",
   "fontSize": 11,
   "fontFamily": 2,
   "textAlign": "left",
   "createdAt": "2026-10-22T07:40:15.182Z",
   "updatedAt": "2026-10-22T07:40:15.182Z",
   "version": 1
  },
