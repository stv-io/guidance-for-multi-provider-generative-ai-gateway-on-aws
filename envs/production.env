# Production profile: Multi-AZ data tier, at least two tasks, own domain via Route53 + ACM.
# Deploy into its own AWS account. Build .env with:
#   cat .env.template envs/production.env > .env
# then fill in the domain and certificate values below and TERRAFORM_S3_BUCKET_NAME.
STACK_ENV="production"
INCLUDE_BASE_MODELS="false"
CPU_ARCHITECTURE="arm"
ECS_VCPUS="2"
DESIRED_CAPACITY="2"
MIN_CAPACITY="2"
MAX_CAPACITY="6"
RDS_INSTANCE_CLASS="db.t4g.medium"
RDS_ALLOCATED_STORAGE_GB="50"
RDS_MULTI_AZ="true"
REDIS_NODE_TYPE="cache.t4g.small"
REDIS_NUM_CACHE_CLUSTERS="2"
NAT_GATEWAY_PER_AZ="true"      # no single-AZ egress dependency for Bedrock and other AWS APIs
USE_CLOUDFRONT="true"
USE_ROUTE53="true"
HOSTED_ZONE_NAME=""            # public hosted zone in this account, e.g. genai.example.com
RECORD_NAME=""                 # e.g. api  ->  api.genai.example.com
# Leave both empty to have the stack request and DNS-validate the certificates in HOSTED_ZONE_NAME.
# Or bring your own: a regional cert for the ALB and a us-east-1 cert for CloudFront, same name.
CERTIFICATE_ARN=""
CLOUDFRONT_CERTIFICATE_ARN=""
