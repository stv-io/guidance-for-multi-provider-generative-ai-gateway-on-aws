# Sandbox PoC profile: smallest footprint that still exercises every component (~$75-85/month).
# Build .env with:  cat .env.template envs/sandbox.env > .env   (later assignments win)
# Then set TERRAFORM_S3_BUCKET_NAME (globally unique) in .env.
STACK_ENV="sandbox"
INCLUDE_BASE_MODELS="false"
CPU_ARCHITECTURE="arm"
ECS_VCPUS="1"
DESIRED_CAPACITY="1"
MIN_CAPACITY="1"
MAX_CAPACITY="2"
RDS_INSTANCE_CLASS="db.t4g.micro"
RDS_MULTI_AZ="false"
REDIS_NODE_TYPE="cache.t4g.micro"
REDIS_NUM_CACHE_CLUSTERS="1"
# Set ALARM_EMAIL in .env (not here: this repo is public)
BEDROCK_MONTHLY_BUDGET_USD="50"
USE_CLOUDFRONT="true"
# MyOps sandbox domain: the stack requests and DNS-validates its own ACM certificates in this public
# zone, and the CloudFront -> ALB hop becomes HTTPS
USE_ROUTE53="true"
HOSTED_ZONE_NAME="sandbox.myops-lab.cloud"
RECORD_NAME="llm"              # -> https://llm.sandbox.myops-lab.cloud
DISABLE_SWAGGER_PAGE="true"
